# Copy to .env.local (which git ignores) and fill in. None of these reach the browser.
#
# Optional. Without Kroger keys the catalog search falls back to Open Food Facts.
# Get keys at https://developer.kroger.com (free).
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Optional. A Kroger store location id; makes Kroger include prices for that store.
KROGER_LOCATION_ID=
# Optional. auto (default) | kroger | openfoodfacts
CATALOG_PROVIDER=auto
