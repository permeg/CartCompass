# Copy this file to .env.local (git ignores it) and fill in the blanks.
# None of these values ever reach the browser.

# From developer.kroger.com -> your app -> credentials. Required for Kroger data.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Added in later roadmap steps. Leave out for now.
# ORS_API_KEY=      # openrouteservice.org, for addresses and drive times
# EIA_API_KEY=      # eia.gov/opendata, for gas prices

# Advanced, and you can ignore them: the app finds Kroger store ids by itself,
# and picks Kroger over Open Food Facts whenever your Kroger keys are present.
# KROGER_LOCATION_ID=
# CATALOG_PROVIDER=auto   # or: kroger | openfoodfacts
